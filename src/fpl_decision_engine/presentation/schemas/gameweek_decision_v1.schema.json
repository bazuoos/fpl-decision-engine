{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fpl-decision-engine.local/schemas/gameweek_decision_v1.schema.json",
  "title": "GameweekDecision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "classification",
    "generation_timestamp",
    "generation_timestamp_semantics",
    "season",
    "target_gameweek",
    "frozen_deadline",
    "engine",
    "source_artifacts",
    "manager_state",
    "players",
    "roll",
    "recommended_action",
    "reliability",
    "validation"
  ],
  "properties": {
    "schema_name": {"const": "GameweekDecision"},
    "schema_version": {"const": "1.0.0"},
    "classification": {"const": "read_only_validated_single_gameweek_decision"},
    "generation_timestamp": {"type": ["string", "null"], "format": "date-time"},
    "generation_timestamp_semantics": {"const": "copied_from_upstream_decision_artifact"},
    "season": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$"},
    "target_gameweek": {"type": "integer", "minimum": 1, "maximum": 38},
    "frozen_deadline": {"type": "string", "format": "date-time"},
    "engine": {"$ref": "#/$defs/engine"},
    "source_artifacts": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/source_artifact"}
    },
    "manager_state": {"$ref": "#/$defs/manager_state"},
    "players": {
      "type": "array",
      "minItems": 15,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/player"}
    },
    "roll": {"$ref": "#/$defs/selection"},
    "recommended_action": {
      "oneOf": [
        {"$ref": "#/$defs/roll_action"},
        {"$ref": "#/$defs/transfer_action"}
      ]
    },
    "reliability": {"$ref": "#/$defs/reliability"},
    "validation": {"$ref": "#/$defs/validation"}
  },
  "$defs": {
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_artifact_version",
        "decision_engine_version",
        "model_id",
        "model_scope",
        "decision_policy",
        "decision_policy_version",
        "reliability_version"
      ],
      "properties": {
        "decision_artifact_version": {"type": "string"},
        "decision_engine_version": {"type": "string"},
        "model_id": {"type": "string"},
        "model_scope": {"type": "string"},
        "decision_policy": {"type": "string"},
        "decision_policy_version": {"type": "string"},
        "reliability_version": {"type": "string"}
      }
    },
    "source_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "artifact_name", "sha256", "hash_validated"],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "artifact_name": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "hash_validated": {"const": true}
      }
    },
    "manager_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_id",
        "bank_units",
        "free_transfers",
        "current_transfer_cost_points",
        "chip_state",
        "squad",
        "verified_provenance"
      ],
      "properties": {
        "entry_id": {"type": "integer", "minimum": 1},
        "bank_units": {"type": "integer", "minimum": 0},
        "free_transfers": {"type": "integer", "minimum": 0},
        "current_transfer_cost_points": {"type": "integer", "minimum": 0},
        "chip_state": {"enum": ["NONE_MODELED"]},
        "squad": {
          "type": "array",
          "minItems": 15,
          "maxItems": 15,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        },
        "verified_provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "manager_state_source",
            "selling_price_source",
            "manager_specific_selling_prices",
            "authentication_data_exposed"
          ],
          "properties": {
            "manager_state_source": {"type": "string", "minLength": 1},
            "selling_price_source": {"type": "string", "minLength": 1},
            "manager_specific_selling_prices": {"const": true},
            "authentication_data_exposed": {"const": false}
          }
        }
      }
    },
    "player": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "element_id",
        "name",
        "team_id",
        "team_name",
        "team_short_name",
        "position",
        "purchase_price_units",
        "selling_price_units",
        "projected_xfp",
        "expected_minutes",
        "prediction_complete",
        "projection_state"
      ],
      "properties": {
        "element_id": {"type": "integer", "minimum": 1},
        "name": {"type": "string", "minLength": 1},
        "team_id": {"type": "integer", "minimum": 1},
        "team_name": {"type": "string", "minLength": 1},
        "team_short_name": {"type": "string", "minLength": 1},
        "position": {"enum": ["GK", "DEF", "MID", "FWD"]},
        "purchase_price_units": {"type": "integer", "minimum": 0},
        "selling_price_units": {"type": ["integer", "null"], "minimum": 0},
        "projected_xfp": {"type": ["number", "null"]},
        "expected_minutes": {"type": ["number", "null"], "minimum": 0},
        "prediction_complete": {"type": "boolean"},
        "projection_state": {
          "enum": [
            "valid_projection",
            "verified_blank",
            "incomplete_projection",
            "missing_projection"
          ]
        }
      }
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_xi_xfp", "captain_bonus_xfp", "total_xfp"],
      "properties": {
        "base_xi_xfp": {"type": "number"},
        "captain_bonus_xfp": {"type": "number"},
        "total_xfp": {"type": "number"}
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "squad",
        "starting_xi",
        "bench",
        "captain",
        "vice_captain",
        "formation",
        "bench_order_semantics",
        "objective",
        "incomplete_projection_ids",
        "warnings"
      ],
      "properties": {
        "squad": {
          "type": "array",
          "minItems": 15,
          "maxItems": 15,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        },
        "starting_xi": {
          "type": "array",
          "minItems": 11,
          "maxItems": 11,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        },
        "bench": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        },
        "captain": {"type": "integer", "minimum": 1},
        "vice_captain": {"type": "integer", "minimum": 1},
        "formation": {"type": "string", "pattern": "^[3-5]-[2-5]-[1-3]$"},
        "bench_order_semantics": {"type": "string", "minLength": 1},
        "objective": {"$ref": "#/$defs/objective"},
        "incomplete_projection_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        },
        "warnings": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "action_selection": {
      "allOf": [
        {"$ref": "#/$defs/selection"},
        {
          "type": "object",
          "properties": {
            "incomplete_projection_ids": {"type": "array"},
            "warnings": {"type": "array"}
          }
        }
      ]
    },
    "roll_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_type", "objective_gain_vs_roll_xfp", "selection"],
      "properties": {
        "action_type": {"const": "ROLL"},
        "objective_gain_vs_roll_xfp": {"const": 0.0},
        "selection": {"$ref": "#/$defs/selection"}
      }
    },
    "player_transfer_out": {
      "type": "object",
      "additionalProperties": false,
      "required": ["element_id", "name", "selling_price_units"],
      "properties": {
        "element_id": {"type": "integer", "minimum": 1},
        "name": {"type": "string", "minLength": 1},
        "selling_price_units": {"type": "integer", "minimum": 0}
      }
    },
    "player_transfer_in": {
      "type": "object",
      "additionalProperties": false,
      "required": ["element_id", "name", "purchase_price_units"],
      "properties": {
        "element_id": {"type": "integer", "minimum": 1},
        "name": {"type": "string", "minLength": 1},
        "purchase_price_units": {"type": "integer", "minimum": 0}
      }
    },
    "transfer_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_type",
        "outgoing",
        "incoming",
        "resulting_bank_units",
        "transfer_cost_points",
        "objective_gain_vs_roll_xfp",
        "selection"
      ],
      "properties": {
        "action_type": {"const": "TRANSFER"},
        "outgoing": {"$ref": "#/$defs/player_transfer_out"},
        "incoming": {"$ref": "#/$defs/player_transfer_in"},
        "resulting_bank_units": {"type": "integer", "minimum": 0},
        "transfer_cost_points": {"type": "integer", "minimum": 0},
        "objective_gain_vs_roll_xfp": {"type": "number"},
        "selection": {"$ref": "#/$defs/selection"}
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1}
      }
    },
    "material_reliability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "element_id",
        "roles",
        "prior_total_minutes",
        "prior_appearances",
        "prior_starts",
        "prior_xg_per_90",
        "prior_xa_per_90",
        "low_sample",
        "prediction_complete",
        "unusually_extreme_attacking_rate",
        "xg_position_rank",
        "xg_position_population",
        "xa_position_rank",
        "xa_position_population"
      ],
      "properties": {
        "element_id": {"type": "integer", "minimum": 1},
        "roles": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "prior_total_minutes": {"type": ["number", "null"], "minimum": 0},
        "prior_appearances": {"type": "integer", "minimum": 0},
        "prior_starts": {"type": ["integer", "null"], "minimum": 0},
        "prior_xg_per_90": {"type": ["number", "null"]},
        "prior_xa_per_90": {"type": ["number", "null"]},
        "low_sample": {"type": "boolean"},
        "prediction_complete": {"type": "boolean"},
        "unusually_extreme_attacking_rate": {"type": "boolean"},
        "xg_position_rank": {"type": ["integer", "null"], "minimum": 1},
        "xg_position_population": {"type": "integer", "minimum": 1},
        "xa_position_rank": {"type": ["integer", "null"], "minimum": 1},
        "xa_position_population": {"type": "integer", "minimum": 1}
      }
    },
    "sensitivity_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "view_id",
        "category",
        "action_type",
        "outgoing_element_id",
        "incoming_element_id",
        "objective_xfp",
        "gain_vs_roll_xfp",
        "retains_official_exact_action"
      ],
      "properties": {
        "view_id": {"type": "string", "minLength": 1},
        "category": {"type": "string", "minLength": 1},
        "action_type": {"enum": ["ROLL", "TRANSFER"]},
        "outgoing_element_id": {"type": ["integer", "null"], "minimum": 1},
        "incoming_element_id": {"type": ["integer", "null"], "minimum": 1},
        "objective_xfp": {"type": "number"},
        "gain_vs_roll_xfp": {"type": "number"},
        "retains_official_exact_action": {"type": "boolean"}
      }
    },
    "reliability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diagnostic_only",
        "official_recommendation_unchanged",
        "sensitivity_view_count",
        "same_exact_action_count",
        "changed_action_count",
        "captaincy_materially_changes_gain",
        "warnings",
        "material_players",
        "sensitivity_results"
      ],
      "properties": {
        "diagnostic_only": {"const": true},
        "official_recommendation_unchanged": {"const": true},
        "sensitivity_view_count": {"type": "integer", "minimum": 0},
        "same_exact_action_count": {"type": "integer", "minimum": 0},
        "changed_action_count": {"type": "integer", "minimum": 0},
        "captaincy_materially_changes_gain": {"type": "boolean"},
        "warnings": {"type": "array", "items": {"$ref": "#/$defs/warning"}},
        "material_players": {
          "type": "array",
          "items": {"$ref": "#/$defs/material_reliability"}
        },
        "sensitivity_results": {
          "type": "array",
          "items": {"$ref": "#/$defs/sensitivity_result"}
        }
      }
    },
    "transfer_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applicable", "passed", "proof", "candidate_count"],
      "properties": {
        "applicable": {"type": "boolean"},
        "passed": {"const": true},
        "proof": {"type": "string", "minLength": 1},
        "candidate_count": {"type": "integer", "minimum": 0}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "squad_legality_passed",
        "xi_legality_passed",
        "bench_accounting_passed",
        "captain_vice_constraints_passed",
        "transfer_legality",
        "all_source_hashes_validated",
        "reliability_provenance_validated"
      ],
      "properties": {
        "squad_legality_passed": {"const": true},
        "xi_legality_passed": {"const": true},
        "bench_accounting_passed": {"const": true},
        "captain_vice_constraints_passed": {"const": true},
        "transfer_legality": {"$ref": "#/$defs/transfer_validation"},
        "all_source_hashes_validated": {"const": true},
        "reliability_provenance_validated": {"const": true}
      }
    }
  }
}
