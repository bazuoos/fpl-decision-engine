{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fpl-decision-engine.local/contracts/research/task033c1_prediction_header.schema.json",
  "title": "Task033 prediction-only artifact boundary header",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "protocol_identity",
    "candidate_identities",
    "stage",
    "source_manifest_identity",
    "source_manifest_sha256",
    "cutoff_view_identity",
    "cutoff_view_sha256",
    "outcome_joined",
    "canonical_order",
    "publication_policy",
    "confirmation_state",
    "hash_claim_scope"
  ],
  "properties": {
    "contract_version": {"const": "task033-prediction-boundary-v1"},
    "protocol_identity": {"const": "TASK033B1B-candidate-freeze-d6716bc"},
    "candidate_identities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "xfp_v01",
          "UM1-joint-minute-dirichlet-v1",
          "UA1-gamma-mixture-loss-update-v1",
          "UM1UA1-v1"
