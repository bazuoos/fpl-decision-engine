      }
    },
    "stage": {"const": "PREDICTION_ONLY"},
    "source_manifest_identity": {"type": "string", "minLength": 1},
    "source_manifest_sha256": {"type": "string", "minLength": 1},
    "cutoff_view_identity": {"type": "string", "minLength": 1},
    "cutoff_view_sha256": {"type": "string", "minLength": 1},
    "outcome_joined": {"const": false},
    "canonical_order": {"const": "season,target_gameweek,element_id,fixture_id"},
    "publication_policy": {"const": "EXCLUSIVE_NO_OVERWRITE"},
    "confirmation_state": {"const": "UNOPENED_UNAUTHORIZED"},
    "hash_claim_scope": {"const": "BYTE_IDENTITY_ONLY_NOT_SEMANTIC_OR_HISTORICAL_PROOF"}
  }
}
