        "assists": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Assists"
        },
        "fixture_id": {
          "minimum": 1,
          "title": "Fixture Id",
          "type": "integer"
        },
        "goals": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Goals"
        },
        "minutes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Minutes"
        },
        "starts": {
          "anyOf": [
            {
              "enum": [
                0,
                1
              ],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Starts"
        }
      },
      "required": [
        "fixture_id",
        "minutes",
        "starts",
        "goals",
        "assists"
      ],
      "title": "FixtureOutcome",
      "type": "object"
    },
    "OutcomeRecord": {
      "additionalProperties": false,
      "properties": {
        "element_id": {
          "minimum": 1,
          "title": "Element Id",
          "type": "integer"
        },
        "fixtures": {
          "items": {
            "$ref": "#/$defs/FixtureOutcome"
          },
          "title": "Fixtures",
          "type": "array"
        },
        "gameweek": {
          "maximum": 38,
          "minimum": 2,
          "title": "Gameweek",
          "type": "integer"
        },
        "season": {
          "minLength": 1,
          "title": "Season",
          "type": "string"
        }
      },
      "required": [
        "season",
        "gameweek",
        "element_id",
        "fixtures"
      ],
      "title": "OutcomeRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "authority": {
      "const": "GENERATED_SYNTHETIC_OUTCOMES",
      "title": "Authority",
      "type": "string"
    },
    "prediction_bytes_sha256": {
