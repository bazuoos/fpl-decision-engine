{
  "components": {
    "schemas": {
      "ArtifactIdentityResponse": {
        "additionalProperties": false,
        "properties": {
          "artifact_schema_version": {
            "const": "1.0.0",
            "title": "Artifact Schema Version",
            "type": "string"
          },
          "artifact_type": {
            "const": "GameweekDecision",
            "title": "Artifact Type",
            "type": "string"
          },
          "final_manifest_sha256": {
            "title": "Final Manifest Sha256",
            "type": "string"
          },
          "preparation_id": {
            "title": "Preparation Id",
            "type": "string"
          },
          "semantic_id": {
            "title": "Semantic Id",
            "type": "string"
          },
          "sha256": {
            "title": "Sha256",
            "type": "string"
          }
        },
        "required": [
          "artifact_type",
          "artifact_schema_version",
          "semantic_id",
          "preparation_id",
          "sha256",
          "final_manifest_sha256"
        ],
        "title": "ArtifactIdentityResponse",
        "type": "object"
      },
      "DecisionReadResponse": {
        "additionalProperties": false,
        "properties": {
          "api_version": {
            "const": "1.0",
            "title": "Api Version",
            "type": "string"
          },
          "artifact_identity": {
            "$ref": "#/components/schemas/ArtifactIdentityResponse"
          },
          "payload": {
            "additionalProperties": true,
            "title": "Payload",
            "type": "object"
          },
          "trust": {
            "$ref": "#/components/schemas/TrustResponse"
          }
        },
        "required": [
          "api_version",
          "artifact_identity",
          "trust",
          "payload"
        ],
        "title": "DecisionReadResponse",
        "type": "object"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "properties": {
          "api_version": {
            "const": "1.0",
            "title": "Api Version",
            "type": "string"
          },
          "status": {
            "const": "ready",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "api_version",
          "status"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "ProblemResponse": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ReadFailureCode"
          },
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code",
          "detail"
        ],
        "title": "ProblemResponse",
        "type": "object"
      },
      "ReadFailureCode": {
        "enum": [
          "UNAUTHORIZED",
          "NOT_FOUND",
          "ARTIFACT_INVALID",
          "HASH_MISMATCH",
          "UNSUPPORTED_SCHEMA",
          "TRUST_CHAIN_INVALID",
          "UPSTREAM_UNAVAILABLE"
        ],
        "title": "ReadFailureCode",
        "type": "string"
      },
      "TrustResponse": {
        "additionalProperties": false,
        "properties": {
          "complete_chain_validated": {
            "const": true,
            "title": "Complete Chain Validated",
            "type": "boolean"
          },
          "reader_version": {
            "title": "Reader Version",
            "type": "string"
          },
          "state": {
            "const": "VERIFIED",
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "state",
          "reader_version",
          "complete_chain_validated"
        ],
        "title": "TrustResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "FPL Decision Application API",
    "version": "1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/decisions/{decision_id}": {
      "get": {
        "operationId": "read_decision_api_v1_decisions__decision_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "decision_id",
            "required": true,
            "schema": {
              "title": "Decision Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DecisionReadResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemResponse"
                }
              }
            },
            "description": "Fail-closed read error"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemResponse"
                }
              }
            },
            "description": "Fail-closed read error"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemResponse"
                }
              }
            },
            "description": "Fail-closed read error"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemResponse"
                }
              }
            },
            "description": "Fail-closed read error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemResponse"
                }
              }
            },
            "description": "Fail-closed read error"
          }
        },
        "summary": "Read Decision"
      }
    },
    "/api/v1/health": {
      "get": {
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    }
  }
}
