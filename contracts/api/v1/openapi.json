  "info": {
    "title": "FPL Decision Application API",
    "version": "1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/decisions/{decision_id}": {
      "get": {
        "operationId": "read_decision_api_v1_decisions__decision_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "decision_id",
            "required": true,
            "schema": {
              "title": "Decision Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DecisionReadResponse"
                }
